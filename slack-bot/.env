# Bot User OAuth Token (starts with xoxb-): Slack app → OAuth & Permissions
SLACK_BOT_TOKEN=
# App-Level Token with connections:write (starts with xapp-): Slack app → Basic Information
SLACK_APP_TOKEN=
# Claude API key (starts with sk-ant-): console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-sonnet-5
# SCRIBBLE_DIR=..
